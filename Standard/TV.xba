<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="TV" script:language="StarBasic" script:moduleType="normal">REM  *****  BASIC  *****
Option Explicit

Global Const path = &quot;/home/otto/Presentation/&quot;
Global Const endFile = &quot;/home/otto/Control/End&quot;
Global Const currentFileControl = &quot;/home/otto/Control/CurrentFile&quot;

&apos; Seconds to pause between slides
Global Const Slideshow_Pause = 7

Global oDoc As Object
Global oPresentation As Object
Global oController As Object	
Global oListener As Object
Global oSlideCount As Integer

&apos; Identify the exact presentation document bash wants shown right now,
&apos; by matching against the control file -- never by guessing at window
&apos; focus, which Sway does not reliably hand off across workspaces.
Function GetPresentationDoc() As Object
    Dim sTargetFile As String
    Dim sTargetURL As String
    Dim oEnum As Object
    Dim oComp As Object
    Dim iFileNo As Integer

    GetPresentationDoc = Nothing
    sTargetFile = ""

    On Error Resume Next
    iFileNo = FreeFile
    Open currentFileControl For Input As #iFileNo
    Line Input #iFileNo, sTargetFile
    Close #iFileNo
    On Error Goto 0

    If sTargetFile &lt;&gt; "" Then
        sTargetURL = ConvertToURL(sTargetFile)
        oEnum = StarDesktop.Components.createEnumeration()
        While oEnum.hasMoreElements()
            oComp = oEnum.nextElement()
            If HasUnoInterfaces(oComp, "com.sun.star.drawing.XDrawPagesSupplier") Then
                If oComp.getURL() = sTargetURL Then
                    GetPresentationDoc = oComp
                    Exit Function
                End If
            End If
        Wend
    End If

    &apos; Last-resort fallback only if the control file was missing or stale
    If HasUnoInterfaces(ThisComponent, "com.sun.star.drawing.XDrawPagesSupplier") Then
        GetPresentationDoc = ThisComponent
    End If
End Function

Sub Main
	Dim Doc as Object
	Dim CurSlide as Object
	Dim i as Integer
	
	Doc = GetPresentationDoc()
	If IsNull(Doc) Then
		&apos; Fail silently or exit without throwing a hard runtime popup blocking the kiosk
		Exit Sub
	End If
	
	&apos; Change slideshow to autoadvance slides, and set the interval
	For i = 0 To Doc.getDrawPages().Count - 1
		CurSlide = Doc.getDrawPages().getByIndex(i)
		
		&apos; Safely guard the controller context
		If Not IsNull(Doc.CurrentController) Then
			Doc.CurrentController.setCurrentPage(CurSlide)
		End If
		
		If CurSlide.Change &lt;&gt; 1 Then
			CurSlide.Change = 1
		End If
		CurSlide.Duration = Slideshow_Pause
	Next i
	
	If Not IsNull(Doc.CurrentController) Then
		CurSlide = Doc.getDrawPages().getByIndex(0)
		Doc.CurrentController.setCurrentPage(CurSlide)
	End If

	If FileExists(endFile) Then
		Kill endFile
	End If

	addListener
End Sub

Sub EV_slideEnded(oEv)
	&apos; Check for end of slide show
	Dim slideIndex as Integer
	
	If IsNull(oController) Then Exit Sub
	
	slideIndex = oController.getCurrentSlideIndex() + 1
	
	If slideIndex = oSlideCount Then
		&apos; If this is the only presentable file in rotation, bash has
		&apos; nothing to hand control back for. Let Impress keep looping
		&apos; on its own (IsEndless is already True) instead of tearing
		&apos; the view down and rebuilding it every pass. Re-checked on
		&apos; every wraparound, so a second file added later is still
		&apos; picked up within one full cycle of this deck.
		If Not IsSoloFile() Then
			writeText(endFile, Now)
			oController.removeSlideShowListener(oListener)
			oController.pause()
		End If
	End If
End Sub

&apos; True only when exactly one presentable file currently sits in the
&apos; rotation folder (config.ini excluded). Adjust the exclusion list
&apos; here if your rotation also mixes in images or video.
Function IsSoloFile() As Boolean
	Dim sFile As String
	Dim iCount As Integer
	iCount = 0
	sFile = Dir(path &amp; "*.*", 0)
	While sFile &lt;&gt; "" And iCount &lt; 2
		If sFile &lt;&gt; "config.ini" Then
			iCount = iCount + 1
		End If
		sFile = Dir()
	Wend
	IsSoloFile = (iCount = 1)
End Function

Sub addListener
	oDoc = GetPresentationDoc()
	If IsNull(oDoc) Then Exit Sub

	oPresentation = oDoc.Presentation

	oPresentation.CustomShow = &quot;&quot;
	oPresentation.FirstPage = &quot;1&quot;
	oPresentation.IsAlwaysOnTop = True
	oPresentation.IsAutomatic = False
	oPresentation.IsMouseVisible = False
	oPresentation.IsEndless = True
	oPresentation.IsFullScreen = True
	oPresentation.IsTransitionOnClick = True
	oPresentation.AllowAnimations = True
	oPresentation.Pause = 5
	oPresentation.Start()
	Wait 300

 	oListener = createUnoListener(&quot;EV_&quot;,&quot;com.sun.star.presentation.XSlideShowListener&quot;)

	Wait 300
	oController = oPresentation.Controller
	
	Wait 300
	
	If Not IsNull(oController) Then
		oController.addSlideShowListener(oListener)
		oSlideCount = oController.getSlideCount()
	End If
End Sub

Sub Reload
	Dim document As Object, dispatcher As Object
	Dim activeDoc As Object
	
	activeDoc = GetPresentationDoc()
	If IsNull(activeDoc) Then Exit Sub
	
	document = activeDoc.CurrentController.Frame
	dispatcher = createUnoService(&quot;com.sun.star.frame.DispatchHelper&quot;)
	dispatcher.executeDispatch(document, &quot;.uno:Reload&quot;, &quot;&quot;, 0, Array())
End Sub

Sub writeText(myFile As String, myText As String)
	Dim FileNo
	FileNo = FreeFile
	Open myFile For Output As #FileNo
		Print #FileNo, myText
	Close #FileNo
End Sub
</script:module>
